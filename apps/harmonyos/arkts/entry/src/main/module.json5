{
  module: {
    name: "entry",
    type: "entry",
    mainElement: "EntryAbility",
    deviceTypes: ["phone", "tablet"],
    deliveryWithInstall: true,
    installationFree: false,
    pages: "$profile:main_pages",
    requestPermissions: [
      { name: "ohos.permission.INTERNET" },
      { name: "ohos.permission.GET_NETWORK_INFO" },
      {
        name: "ohos.permission.MICROPHONE",
        reason: "$string:microphone_permission_reason",
        usedScene: { abilities: ["EntryAbility"], when: "inuse" },
      },
    ],
    abilities: [
      {
        name: "EntryAbility",
        srcEntry: "./ets/entryability/EntryAbility.ets",
        label: "$string:app_name",
        icon: "$media:app_icon",
        startWindowIcon: "$media:app_icon",
        startWindowBackground: "$color:start_window_background",
        exported: true,
        skills: [
          {
            entities: ["entity.system.home"],
            actions: ["ohos.want.action.home"],
          },
          {
            entities: ["entity.system.browsable"],
            actions: ["ohos.want.action.viewData"],
            uris: [
              { scheme: "clerk", host: "com.t3tools.t3code.dev.hosted-callback" },
              { scheme: "t3code", host: "pair" },
              { scheme: "t3code-dev", host: "pair" },
              { scheme: "t3code-preview", host: "pair" },
              { scheme: "t3code", host: "threads" },
              { scheme: "t3code-dev", host: "threads" },
              { scheme: "t3code-preview", host: "threads" },
            ],
          },
          {
            actions: ["ohos.want.action.sendData", "ohos.want.action.sendMultipleData"],
            uris: [{ type: "text/*" }, { type: "image/*" }, { type: "*/*" }],
          },
        ],
      },
    ],
  },
}
