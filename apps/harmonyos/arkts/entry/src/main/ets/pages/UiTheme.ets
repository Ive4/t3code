export function workspaceHeaderColor(dark: boolean): string {
  return dark ? '#141414' : '#f4f4f5';
}

export function workspaceGroupedCardColor(dark: boolean): string {
  return dark ? '#1a1b1b' : '#f4f4f5';
}

export function workspaceSurfaceColor(dark: boolean): string {
  return dark ? '#0a0a0a' : '#fcfcfc';
}

export function workspaceForegroundColor(dark: boolean): string {
  return dark ? '#f5f5f5' : '#27272a';
}

export function workspaceMutedColor(dark: boolean): string {
  return dark ? '#a3a3a3' : '#6f6f79';
}

export function workspaceNavigationBarColor(dark: boolean): string {
  return dark ? '#242424' : '#eaeaeb';
}
