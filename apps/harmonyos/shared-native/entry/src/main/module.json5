{
  module: {
    name: "entry",
    type: "entry",
    mainElement: "EntryAbility",
    deviceTypes: ["phone"],
    deliveryWithInstall: true,
    installationFree: false,
    pages: "$profile:main_pages",
    requestPermissions: [
      { name: "ohos.permission.INTERNET" },
      { name: "ohos.permission.GET_NETWORK_INFO" },
      { name: "ohos.permission.ACCELEROMETER" },
      {
        name: "ohos.permission.MICROPHONE",
        reason: "$string:microphone_permission_reason",
        usedScene: { abilities: ["EntryAbility"], when: "inuse" },
      },
    ],
    abilities: [
      {
        name: "EntryAbility",
        srcEntry: "./ets/entryability/EntryAbility.ets",
        label: "$string:app_name",
        icon: "$media:app_icon",
        startWindowIcon: "$media:app_icon",
        startWindowBackground: "$color:start_window_background",
        exported: true,
        metadata: [{ name: "ohos.ability.shortcuts", resource: "$profile:shortcuts_config" }],
        skills: [
          {
            entities: ["entity.system.home"],
            actions: ["ohos.want.action.home"],
          },
          {
            entities: ["entity.system.browsable"],
            actions: ["ohos.want.action.viewData"],
            uris: [{ scheme: "clerk", host: "com.t3tools.t3code.dev.hosted-callback" }],
          },
          {
            entities: ["entity.system.browsable"],
            actions: ["ohos.want.action.viewData"],
            uris: [{ scheme: "https", host: "app.t3.codes", pathStartWith: "threads/" }],
            domainVerify: true,
          },
          {
            entities: ["entity.system.browsable"],
            actions: ["ohos.want.action.viewData"],
            uris: [
              { scheme: "t3code", host: "pair" },
              { scheme: "t3code", host: "threads" },
              { scheme: "t3code", host: "settings" },
              { scheme: "t3code", host: "new" },
              { scheme: "t3code", host: "connections" },
              { scheme: "t3code", host: "pull-requests" },
              { scheme: "t3code", host: "issues" },
              { scheme: "t3code", host: "environments" },
              { scheme: "t3code", host: "connect-onboarding" },
              { scheme: "t3code", host: "workflows" },
              { scheme: "t3code-dev", host: "pair" },
              { scheme: "t3code-dev", host: "threads" },
              { scheme: "t3code-dev", host: "settings" },
              { scheme: "t3code-dev", host: "new" },
              { scheme: "t3code-dev", host: "connections" },
              { scheme: "t3code-dev", host: "pull-requests" },
              { scheme: "t3code-dev", host: "issues" },
              { scheme: "t3code-dev", host: "environments" },
              { scheme: "t3code-dev", host: "connect-onboarding" },
              { scheme: "t3code-dev", host: "workflows" },
              { scheme: "t3code-preview", host: "pair" },
              { scheme: "t3code-preview", host: "threads" },
              { scheme: "t3code-preview", host: "settings" },
              { scheme: "t3code-preview", host: "new" },
              { scheme: "t3code-preview", host: "connections" },
              { scheme: "t3code-preview", host: "pull-requests" },
              { scheme: "t3code-preview", host: "issues" },
              { scheme: "t3code-preview", host: "environments" },
              { scheme: "t3code-preview", host: "connect-onboarding" },
              { scheme: "t3code-preview", host: "workflows" },
            ],
          },
          {
            actions: ["ohos.want.action.sendData"],
            uris: [
              { scheme: "file", utd: "general.text", maxFileSupported: 10 },
              { scheme: "file", utd: "general.hyperlink", maxFileSupported: 10 },
              { scheme: "file", utd: "general.image", maxFileSupported: 10 },
              { scheme: "file", utd: "general.file", maxFileSupported: 10 },
            ],
          },
        ],
      },
    ],
    extensionAbilities: [
      {
        name: "UsageWidgetAbility",
        srcEntry: "./ets/widgets/UsageWidgetAbility.ets",
        label: "$string:usage_widget_title",
        type: "form",
        metadata: [{ name: "ohos.extension.form", resource: "$profile:usage_widget" }],
      },
    ],
  },
}
