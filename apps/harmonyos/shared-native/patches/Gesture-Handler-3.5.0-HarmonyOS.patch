@@ -0,0 +1,94 @@
+#include "RNGestureHandlerDetectorComponentInstance.h"
+
+#include <react/renderer/core/propsConversions.h>
+#include "RNOH/RNInstance.h"
+
+namespace facebook::react {
+
+const char RNGestureHandlerDetectorComponentName[] = "RNGestureHandlerDetector";
+
+void fromRawValue(
+    const PropsParserContext& context, const RawValue& value, RNGestureHandlerVirtualChild& result) {
+    auto fields = static_cast<std::unordered_map<std::string, RawValue>>(value);
+    if (auto field = fields.find("viewTag"); field != fields.end()) {
+        fromRawValue(context, field->second, result.viewTag);
+    }
+    if (auto field = fields.find("handlerTags"); field != fields.end()) {
+        fromRawValue(context, field->second, result.handlerTags);
+    }
+}
+
+RNGestureHandlerDetectorProps::RNGestureHandlerDetectorProps(
+    const PropsParserContext& context,
+    const RNGestureHandlerDetectorProps& source,
+    const RawProps& rawProps)
+    : ViewProps(context, source, rawProps),
+      moduleId(convertRawProp(context, rawProps, "moduleId", source.moduleId, -1)),
+      handlerTags(convertRawProp(context, rawProps, "handlerTags", source.handlerTags, {})),
+      virtualChildren(convertRawProp(context, rawProps, "virtualChildren", source.virtualChildren, {})) {}
+
+} // namespace facebook::react
+
+namespace rnoh {
+
+facebook::jsi::Object RNGestureHandlerDetectorJSIBinder::createNativeProps(facebook::jsi::Runtime& rt) {
+    auto props = ViewComponentJSIBinder::createNativeProps(rt);
+    props.setProperty(rt, "moduleId", "number");
+    props.setProperty(rt, "handlerTags", "Array");
+    props.setProperty(rt, "virtualChildren", "Array");
+    return props;
+}
+
+facebook::jsi::Object RNGestureHandlerDetectorJSIBinder::createDirectEventTypes(facebook::jsi::Runtime& rt) {
+    auto events = ViewComponentJSIBinder::createDirectEventTypes(rt);
+    for (const auto* suffix : gestureDetectorEventSuffixes) {
+        events.setProperty(rt, ("top" + std::string(suffix)).c_str(), createDirectEvent(rt, "on" + std::string(suffix)));
+    }
+    return events;
+}
+
+RNGestureHandlerDetectorComponentInstance::~RNGestureHandlerDetectorComponentInstance() {
+    if (!m_attachment.isNull()) {
+        if (auto instance = m_deps->rnInstance.lock()) {
+            instance->postMessageToArkTS("RNGH::DETECTOR_REMOVED", getTag());
+        }
+    }
+}
+
+void RNGestureHandlerDetectorComponentInstance::onFinalizeUpdates() {
+    ViewComponentInstance::onFinalizeUpdates();
+    auto props = std::dynamic_pointer_cast<const facebook::react::RNGestureHandlerDetectorProps>(getProps());
+    if (!props) {
+        return;
+    }
+
+    auto tagsToDynamic = [](const auto& tags) {
+        auto result = folly::dynamic::array();
+        for (auto tag : tags) {
+            result.push_back(tag);
+        }
+        return result;
+    };
+
+    auto virtualChildren = folly::dynamic::array();
+    for (const auto& child : props->virtualChildren) {
+        virtualChildren.push_back(folly::dynamic::object
+            ("viewTag", child.viewTag)
+            ("handlerTags", tagsToDynamic(child.handlerTags)));
+    }
+    const auto& children = getChildren();
+    folly::dynamic attachment = folly::dynamic::object
+        ("tag", getTag())
+        ("moduleId", props->moduleId)
+        ("handlerTags", tagsToDynamic(props->handlerTags))
+        ("childTag", children.size() == 1 ? children.front()->getTag() : 0)
+        ("virtualChildren", std::move(virtualChildren));
+    if (attachment != m_attachment) {
+        if (auto instance = m_deps->rnInstance.lock()) {
+            instance->postMessageToArkTS("RNGH::DETECTOR_UPDATED", attachment);
+        }
+        m_attachment = std::move(attachment);
+    }
+}
+
+} // namespace rnoh
