+void RNGestureHandlerModule::installStateSetter(jsi::Runtime& runtime, const char* name, bool async) {
+    runtime.global().setProperty(runtime, name, jsi::Function::createFromHostFunction(
+        runtime, jsi::PropNameID::forAscii(runtime, name), 2,
+        [weak = weak_from_this(), async](jsi::Runtime& rt, const jsi::Value&, const jsi::Value* args, size_t count) {
+            if (auto module = weak.lock(); module && count == 2) {
+                if (async) {
+                    module->scheduleCall(rt, "setGestureHandlerState", args, count);
+                } else {
+                    module->call(rt, "setGestureHandlerState", args, count);
+                }
+            }
+            return jsi::Value::undefined();
+        }));
+}
+
+bool RNGestureHandlerModule::installUIRuntimeBindings(jsi::Runtime& runtime) {
+#if RNGH_WITH_WORKLETS
+    auto holder = runtime.global().getProperty(runtime, "__RNGH_UI_WORKLET_RUNTIME_HOLDER");
+    if (holder.isObject()) {
+        if (auto worklet = worklets::getWorkletRuntimeFromHolder(runtime, holder.asObject(runtime))) {
+            installStateSetter(worklets::getJSIRuntimeFromWorkletRuntime(worklet), "_setGestureStateSync", false);
+            return true;
+        }
+    }
+#endif
+    return false;
+}
+
 } // namespace rnoh
